+
+    if (!empty($resident_record['birth_date']) && $resident_record['birth_date'] !== '0000-00-00') {
+        $bDate = new DateTime($resident_record['birth_date']);
+        $today = new DateTime();
+        $rAge = $today->diff($bDate)->y;
+        if ($rAge >= 60) {
+            $user_is_senior = true;
+            $_SESSION['is_senior_citizen'] = true;
+            if (($resident_record['senior_citizen'] ?? 0) != 1) {
+                $db->prepare("UPDATE residents SET senior_citizen = 1 WHERE user_id = :uid")->execute([':uid' => $_SESSION['user_id']]);
+                $resident_record['senior_citizen'] = 1;
+            }
+        } else {
+            if (($resident_record['senior_citizen'] ?? 0) == 1) {
+                $db->prepare("UPDATE residents SET senior_citizen = 0 WHERE user_id = :uid")->execute([':uid' => $_SESSION['user_id']]);
+                $resident_record['senior_citizen'] = 0;
+            }
+            $_SESSION['is_senior_citizen'] = false;
+        }
+    }
+} catch (Exception $e) {
+    $has_profile_details = false;
+}
+if (isset($_SESSION['is_senior_citizen'])) {
+    $user_is_senior = !empty($_SESSION['is_senior_citizen']);
+}
+
